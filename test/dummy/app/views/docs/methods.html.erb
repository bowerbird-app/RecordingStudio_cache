<% content_for :title, "Methods" %>
<% content_for :subtitle, "Fetch, write, and invalidate through RecordingStudioCache." %>
<% dummy_page_nav(back_url: root_path) %>

<div class="flex w-full flex-col gap-6">

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Fetch",
    subtitle: "RecordingStudioCache.fetch",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      payload = RecordingStudioCache.fetch(recording, :api_payload, policy: :api_payload) do
        expensive_api_payload_for(recording)
      end

      RecordingStudioCache.invalidate_tree!(recording.root_recording_or_self)
    CODE
  ) %>

  <p class="text-sm text-(--body-muted-content-color)">
    RateLimiter is a separate helper on RecordingStudioCache::RateLimiter.
  </p>
</div>
