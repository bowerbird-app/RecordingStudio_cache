<% dummy_page_nav(title: "Cache Demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "RecordingStudioCache",
    subtitle: "App-side Rails.cache primitives — not Cloudflare, R2, or Artifacts.",
    variant: :h1
  ) %>

  <% if notice.present? %>
    <%= render FlatPack::Alert::Component.new(style: :success, title: notice) %>
  <% end %>

  <% if @root %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "fetch(recording, :api_payload)",
          subtitle: "Workspace root recording under Solid-Cache-ready Rails.cache (memory store in dummy).",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <dl class="space-y-3 text-sm leading-6">
          <div>
            <dt class="font-medium">Tree version</dt>
            <dd><code><%= @tree_version %></code></dd>
          </div>
          <div>
            <dt class="font-medium">Cache key</dt>
            <dd class="break-all"><code><%= @cache_key %></code></dd>
          </div>
          <div>
            <dt class="font-medium">Payload</dt>
            <dd><pre class="whitespace-pre-wrap text-xs"><%= JSON.pretty_generate(@payload) %></pre></dd>
          </div>
        </dl>
      <% end %>

      <% card.footer do %>
        <%= link_to root_path(invalidate: 1), class: "inline-flex" do %>
          <%= render FlatPack::Button::Component.new(
            text: "Invalidate tree",
            style: :secondary,
            size: :md
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::Alert::Component.new(
      style: :warning,
      title: "No workspace seeded",
      message: "Run db:seed to create Studio Workspace."
    ) %>
  <% end %>
</div>
